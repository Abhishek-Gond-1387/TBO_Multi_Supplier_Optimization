# Copy to .env for local development. Never commit .env or production credentials.
APP_NAME="TBO Multi-Supplier Inventory Engine"
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
USE_DATABASE=false
USE_REDIS=false
ENABLE_SEMANTIC_MATCHING=false
ENABLE_ZERO_SHOT_INCLUSIONS=false

DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tbo_inventory
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/tbo_inventory
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DB_TIMEOUT_SECONDS=30

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ZERO_SHOT_MODEL_NAME=facebook/bart-large-mnli
WHISPER_MODEL_SIZE=tiny
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=http://router.project-osrm.org
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
MAP_TILE_SERVER_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors © CARTO"
MAP_DEFAULT_LATITUDE=25.1972
MAP_DEFAULT_LONGITUDE=55.2744
MAP_DEFAULT_ZOOM=12

DEDUP_AUTO_MERGE_THRESHOLD=0.88
DEDUP_HUMAN_REVIEW_THRESHOLD=0.65
DEDUP_MAX_GEO_DISTANCE_METERS=250
RANKING_WEIGHT_RELEVANCE=0.25
RANKING_WEIGHT_PRICE_COMPETITIVENESS=0.25
RANKING_WEIGHT_SUPPLIER_RELIABILITY=0.20
RANKING_WEIGHT_CONTENT_QUALITY=0.10
RANKING_WEIGHT_CANCELLATION_FLEXIBILITY=0.10
RANKING_WEIGHT_CONVERSION_PRIOR=0.10

# Replace these values with locally generated secrets before using auth or encryption.
JWT_SECRET_KEY=replace_with_a_random_secret_before_deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY=replace_with_32_random_bytes

ENABLE_INTERACTIVE_MAP=true
ENABLE_VOICE_ASSISTANT=true
ENABLE_HUMAN_REVIEW_QUEUE=true
ENABLE_CELERY=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=30
CACHE_TTL_LIVE_RATES=300
CACHE_TTL_GEO_VIEWPORT=1800
