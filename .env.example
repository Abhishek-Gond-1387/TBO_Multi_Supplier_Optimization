# Local Delhi inventory pilot. No supplier credentials or paid API keys are needed.
APP_NAME=TBO Delhi Inventory Quality Pilot
APP_ENV=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1
USE_DATABASE=false
USE_REDIS=false
ENABLE_CELERY=false

# Free public OpenStreetMap/Overpass source and OpenFreeMap vector style.
DEMO_CITY=Delhi
MAP_DEFAULT_DESTINATION=Delhi
MAP_DEFAULT_LATITUDE=28.6139
MAP_DEFAULT_LONGITUDE=77.2090
MAP_DEFAULT_ZOOM=11
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Match thresholds are candidate thresholds. No merge is written automatically.
DEDUP_AUTO_MERGE_THRESHOLD=0.88
DEDUP_HUMAN_REVIEW_THRESHOLD=0.65
DEDUP_MAX_GEO_DISTANCE_METERS=250
CACHE_TTL_GEO_VIEWPORT=1800
